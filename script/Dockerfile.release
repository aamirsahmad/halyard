# Release build environment for Linux packages. Ubuntu 22.04 (glibc 2.35) so
# the binaries run on every distribution from that era onwards.
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
COPY script/install-linux-deps.sh /tmp/install-linux-deps.sh
RUN /tmp/install-linux-deps.sh && apt-get install -y --no-install-recommends file unzip perl \
    && rm -rf /var/lib/apt/lists/*
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain none
ENV PATH=/root/.cargo/bin:$PATH
WORKDIR /src
